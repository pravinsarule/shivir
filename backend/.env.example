PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:root@localhost:5432/shibir_db
DATABASE_SSL=true

# SMTP delivery. Do not use placeholder values in production.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@yourdomain.com

# Easebuzz hosted checkout. Use credentials from your Easebuzz merchant dashboard.
EASEBUZZ_MERCHANT_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test
# e.g. https://api.yourdomain.in (must be publicly reachable by Easebuzz)
PUBLIC_API_URL=
# Keep false while invitations are issued directly without online payment.
PAYMENTS_ENABLED=false
